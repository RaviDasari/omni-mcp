{
  "name": "omni-mcp-manager",
  "version": "1.3.0",
  "description": "One proxy. All your MCP servers. Every IDE.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "omni-mcp": "./dist/cli/index.js",
    "omni-mcp-manager": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:web && tsup && node scripts/copy-assets.mjs",
    "build:web": "npm --prefix web run build",
    "dev": "tsup --watch",
    "dev:ui": "npm --prefix web run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "lint:web": "npm --prefix web run lint",
    "start": "node dist/cli/index.js start",
    "dev:start": "npm run build && node dist/cli/index.js start --foreground",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "gateway",
    "ai",
    "cursor",
    "vscode",
    "claude"
  ],
  "author": "Ravi Dasari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaviDasari/omni-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/RaviDasari/omni-mcp/issues"
  },
  "homepage": "https://github.com/RaviDasari/omni-mcp#readme",
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "conventional-commits-filter": "^6.0.1",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
